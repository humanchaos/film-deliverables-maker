# NEVER v2 — Environment Variables Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to git. It is listed in .gitignore.

# Google Gemini API Key (backend only — NOT exposed to browser)
# Get from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your-gemini-api-key-here


# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=gen-lang-client-0431510360

# Google Cloud Storage Bucket
GCS_BUCKET=gemini-deliverables-app
VITE_GOOGLE_CLOUD_STORAGE_BUCKET=gemini-deliverables-app
