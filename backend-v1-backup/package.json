{
    "name": "gemini-video-analysis-backend",
    "version": "1.0.0",
    "description": "Serverless backend for video analysis jobs",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node-dev src/index.ts",
        "test-local": "ts-node-dev scripts/test-local.ts",
        "test:mock": "ts-node-dev scripts/mock_test_pipeline.ts --mock-gemini",
