        "test:full": "ts-node-dev scripts/mock_test_pipeline.ts --full"
    },
    "dependencies": {
        "@google-cloud/storage": "^7.7.0",
        "@google-cloud/tasks": "^5.0.0",
        "@google-cloud/video-intelligence": "^5.2.0",
        "@google-cloud/video-transcoder": "^4.4.1",
        "@google/genai": "^0.10.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "firebase-admin": "^11.11.0",
        "@types/cors": "^2.8.15",
        "@types/express": "^4.17.20",
        "@types/node": "^20.8.7",
        "@types/node-fetch": "^2.6.13",
        "node-fetch": "^3.3.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.2.2"
